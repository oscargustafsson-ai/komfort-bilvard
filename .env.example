# Kontaktformulärets mejlutskick (Resend — https://resend.com)
# Skapa ett gratis konto, generera en API-nyckel och klistra in den här
# i en fil som heter .env.local (committas aldrig).
RESEND_API_KEY=

# Vart förfrågningar skickas. Default: Komfort802@gmail.com
CONTACT_TO_EMAIL=

# Avsändare. Med Resends testdomän fungerar onboarding@resend.dev direkt.
# I produktion: verifiera en egen domän och använd t.ex. "KOM-FORT <info@komfort-bilvard.se>"
CONTACT_FROM_EMAIL=

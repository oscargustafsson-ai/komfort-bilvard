# Kontaktformulärets mejlutskick (Resend — https://resend.com)
# Skapa ett gratis konto, generera en API-nyckel och klistra in den här
# i en fil som heter .env.local (committas aldrig).
RESEND_API_KEY=

# Vart förfrågningar skickas. Default: Komfort802@gmail.com
CONTACT_TO_EMAIL=

# Avsändare. Med Resends testdomän fungerar onboarding@resend.dev direkt.
# I produktion: verifiera en egen domän och använd t.ex. "KOM-FORT <info@komfortbil.se>"
CONTACT_FROM_EMAIL=

# Zettle-betallänk för presentkort.
# Lämna tom tills Göran aktiverat presentkort i Zettle och skickat sin länk.
# Tom => /presentkort visar beställningsformulär som mejlar förfrågan.
# Ifylld => sidan visar i stället en knapp rakt till Zettle. Måste börja med https://
NEXT_PUBLIC_ZETTLE_GIFTCARD_URL=

# Presentkorts-subdomän (valfritt).
# Värdnamn som ska visa presentkortssidan direkt på sin rot, t.ex.
# "presentkort.komfortbil.se". Flera anges kommaseparerat.
# Peka subdomänen till samma Vercel-projekt (Settings → Domains) och sätt denna.
# Tom => ingen subdomän, sidan nås bara på /presentkort.
NEXT_PUBLIC_GIFTCARD_HOST=

# Sajtens bas-URL (valfritt). Styr canonical, sitemap och robots.
# Tom => https://www.komfortbil.se, vilket är rätt för produktion. Sätt bara för en
# avvikande miljö. Pekar den på localhost eller *.vercel.app blockeras indexering.
NEXT_PUBLIC_SITE_URL=
